{
  "name": "noten",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare-helper": "powershell -ExecutionPolicy Bypass -File .\\scripts\\prepare-helper.ps1",
    "prepare-helper:release": "powershell -ExecutionPolicy Bypass -File .\\scripts\\prepare-helper.ps1 -Release",
    "tauri:dev": "npm run prepare-helper && tauri dev",
    "sync-version": "node scripts/sync-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run src/smoke",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@fluentui/react-components": "^9.73.3",
    "@fluentui/react-icons": "^2.0.321",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@tiptap/core": "~3.31.3",
    "@tiptap/extension-code-block-lowlight": "~3.31.3",
    "@tiptap/extension-image": "~3.31.3",
    "@tiptap/extension-link": "~3.31.3",
    "@tiptap/extension-list": "~3.31.3",
    "@tiptap/extension-placeholder": "~3.31.3",
    "@tiptap/extension-table": "~3.31.3",
    "@tiptap/extension-table-cell": "~3.31.3",
    "@tiptap/extension-table-header": "~3.31.3",
    "@tiptap/extension-table-row": "~3.31.3",
    "@tiptap/extension-task-item": "~3.31.3",
    "@tiptap/extension-task-list": "~3.31.3",
    "@tiptap/extension-text-align": "~3.31.3",
    "@tiptap/extension-typography": "~3.31.3",
    "@tiptap/extension-underline": "~3.31.3",
    "@tiptap/markdown": "~3.31.3",
    "@tiptap/pm": "~3.31.3",
    "@tiptap/react": "~3.31.3",
    "@tiptap/starter-kit": "~3.31.3",
    "@tiptap/suggestion": "~3.31.3",
    "lowlight": "^3.3.0",
    "mermaid": "^12.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
